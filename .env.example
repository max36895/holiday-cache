# Скопируйте в .env и заполните. .env в git не попадает.
# Пустые значения umbot пропускает: платформа без токена просто не сможет отправлять сообщения.

# --- Telegram ---
TELEGRAM_TOKEN=
# Секрет вебхука: `npx umbot webhook telegram https://<домен>/` создаёт его и регистрирует вебхук
TELEGRAM_WEBHOOK_SECRET=
# Имя бота без @ — для ссылки t.me/<имя>?start=<код> в приглашении
TELEGRAM_BOT_NAME=

# --- VK (Callback API сообщества) ---
VK_TOKEN=
VK_CONFIRMATION_TOKEN=
# Секретный ключ из настроек Callback API: umbot отклоняет запросы без него
VK_SECRET_KEY=
# Короткое имя или id сообщества — для ссылки vk.me/<имя>?ref=<код> в приглашении
VK_GROUP=

# --- MAX ---
MAX_TOKEN=
# Секрет вебхука: `npx umbot webhook max https://<домен>/`
MAX_WEBHOOK_SECRET=
# Имя бота — для ссылки max.ru/<имя>?start=<код>
MAX_BOT_NAME=

# --- Алиса ---
# Для ответов навыка токен не нужен; нужен только для загрузки картинок и проверки `umbot doctor`
ALISA_TOKEN=
# Название навыка — для строки «Алиса, запусти навык …» в приглашении
ALISA_SKILL_NAME=

# --- Бот ---
HOST=0.0.0.0
PORT=3000
# Файл SQLite для продакшена. Пусто — файловая БД umbot в ./json (только для разработки)
SQLITE_FILE=./data/rooms.sqlite
# Режим разработки: тестовый терминал BotTest вместо HTTP-сервера. В продакшене не задавать
# IS_DEV=1
# Ссылка на политику конфиденциальности: показывается в первом сообщении и в «помощи»
PRIVACY_POLICY_URL=
# Пауза между сообщениями рассылки, мс
SEND_DELAY_MS=100

# Прокси
TG_WORKER_URL=
TG_API_SECRET=
